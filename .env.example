# Copy to .env. Never commit .env or private keys.
PO_DATA_DIR=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=PO_WH
SNOWFLAKE_DATABASE=PURCHASE_ORDER_DB
SNOWFLAKE_SCHEMA=RAW
# Prefer key-pair; password is fine for the trial ACCOUNTADMIN until a key-pair user exists.
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_BATCH_SIZE=50
SNOWFLAKE_FLUSH_SECONDS=2
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
SOURCE_API_URL=http://127.0.0.1:8000
TARGET_API_URL=http://127.0.0.1:8001
